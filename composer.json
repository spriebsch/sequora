{
  "name": "spriebsch/sequora",
  "description": "A simple, reliable SQLite-backed event store for PHP domain events",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "spriebsch/domain-event": "^2.0",
    "spriebsch/sqlite": "^2.1",
    "ext-sqlite3": "*"
  },
  "autoload": {
    "classmap": [
      "src"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests"
    ]
  },
  "scripts": {
    "clean": "rm -rf build",
    "code-coverage": "phpunit --coverage-text"
  },
  "bin": [
    "bin/sequora-dump"
  ]
}
